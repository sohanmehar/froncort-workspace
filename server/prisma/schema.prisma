datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  SUPPORT_AGENT
  REVIEWER
  CROSS_ORG_GUEST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PRStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  MERGED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ResourceType {
  TICKET
  PR
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  tokenVersion   Int            @default(0) // Used for global logout token revocation
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships    Membership[]
  auditLogs      AuditLog[]
  comments       TicketComment[]
  prReviews      PRReview[]
  notifications  Notification[]

  @@index([email])
}

model Organization {
  id              String           @id @default(uuid())
  name            String
  domain          String           @unique
  createdAt       DateTime         @default(now())

  memberships     Membership[]
  tickets         Ticket[]
  pullRequests    PullRequest[]
  auditLogs       AuditLog[]
  
  initiatedConns  OrgConnection[]  @relation("InitiatorOrg")
  receivedConns   OrgConnection[]  @relation("ReceiverOrg")
  sharedResources SharedResource[] @relation("SharedWithOrg")
}

model Membership {
  id           String       @id @default(uuid())
  userId       String
  orgId        String
  role         Role         @default(SUPPORT_AGENT)
  createdAt    DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId, userId])
}

model Ticket {
  id            String           @id @default(uuid())
  orgId         String
  title         String
  description   String
  status        TicketStatus     @default(OPEN)
  createdById   String
  assignedToId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comments      TicketComment[]
  sharedEntries SharedResource[] @relation("SharedTicket")

  @@index([orgId])
  @@index([assignedToId])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PullRequest {
  id                String           @id @default(uuid())
  orgId             String
  title             String
  description       String
  status            PRStatus         @default(DRAFT)
  authorId          String
  requiredApprovals Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions          PRVersion[]
  reviews           PRReview[]
  sharedEntries     SharedResource[] @relation("SharedPR")

  @@index([orgId])
}

model PRVersion {
  id            String      @id @default(uuid())
  prId          String
  versionNumber Int
  title         String
  description   String
  diff          String
  createdAt     DateTime    @default(now())

  pullRequest   PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, versionNumber])
}

model PRReview {
  id          String      @id @default(uuid())
  prId        String
  reviewerId  String
  status      PRStatus
  comment     String?
  createdAt   DateTime    @default(now())

  pullRequest PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model OrgConnection {
  id             String           @id @default(uuid())
  initiatorOrgId String
  receiverOrgId  String
  status         ConnectionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  initiatorOrg   Organization     @relation("InitiatorOrg", fields: [initiatorOrgId], references: [id])
  receiverOrg    Organization     @relation("ReceiverOrg", fields: [receiverOrgId], references: [id])

  @@unique([initiatorOrgId, receiverOrgId])
}

model SharedResource {
  id              String       @id @default(uuid())
  resourceType    ResourceType
  ticketId        String?
  prId            String?
  sharedWithOrgId String
  sharedAt        DateTime     @default(now())

  sharedWithOrg   Organization @relation("SharedWithOrg", fields: [sharedWithOrgId], references: [id])
  ticket          Ticket?      @relation("SharedTicket", fields: [ticketId], references: [id])
  pullRequest     PullRequest? @relation("SharedPR", fields: [prId], references: [id])

  @@index([sharedWithOrgId])
}

model AuditLog {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}